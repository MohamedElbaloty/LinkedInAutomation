# Google Gemini & Imagen API Key
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Destination Chat or Channel ID
# Examples: 123456789 (user chat), -1001234567890 (channel/group), or @channel_username
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional Configurations
TEXT_MODEL=gemini-2.5-flash
IMAGE_MODEL=imagen-3.0-generate-002
DB_PATH=news_history.db
IMAGES_DIR=output_images
SCHEDULE_HOURS=9,18
